{
  "format": "receiptd.pretooluse.v1",
  "description": "Default PreToolUse rules. The hook hashes these file bytes and evaluates the rules parsed from the same bytes.",
  "base_score": 10,
  "deny_at": 75,
  "rules": [
    {
      "id": "POL-01:ENV_EXFILTRATION",
      "weight": 95,
      "ignore_case": true,
      "pattern": "(?s)\\A(?=.*(?:\\b(?:cat|tar|head|tail|sed|awk|grep|scp|rsync)\\s+[^\\n;&|]*?(?:\\.(?:ssh|aws|config/gcloud)(?=[/\\s\"\\x27;|]|$)|\\.netrc\\b|(?<![\\w.])\\.env(?!\\.example\\b)(?=[.\\s\"\\x27;|]|$)|\\.pem\\b|\\bkeychain\\b|\\bid_(?:rsa|ed25519)(?!\\.pub)\\b|\\b(?:AWS_SECRET_ACCESS_KEY|AWS_ACCESS_KEY_ID|PRIVATE_KEY)\\b)|@[^\\s\"\\x27]*?(?:\\.(?:ssh|aws|config/gcloud)(?=[/\\s\"\\x27;|]|$)|\\.netrc\\b|(?<![\\w.])\\.env(?!\\.example\\b)(?=[.\\s\"\\x27;|]|$)|\\.pem\\b|\\bkeychain\\b|\\bid_(?:rsa|ed25519)(?!\\.pub)\\b|\\b(?:AWS_SECRET_ACCESS_KEY|AWS_ACCESS_KEY_ID|PRIVATE_KEY)\\b)|(?:-T|--upload-file)(?:\\s+|=)[\"\\x27]?[^\\s\"\\x27]*?(?:\\.(?:ssh|aws|config/gcloud)(?=[/\\s\"\\x27;|]|$)|\\.netrc\\b|(?<![\\w.])\\.env(?!\\.example\\b)(?=[.\\s\"\\x27;|]|$)|\\.pem\\b|\\bkeychain\\b|\\bid_(?:rsa|ed25519)(?!\\.pub)\\b|\\b(?:AWS_SECRET_ACCESS_KEY|AWS_ACCESS_KEY_ID|PRIVATE_KEY)\\b)|\\bopen\\(\\s*\\\\?[\"\\x27][^\\n]*?(?:\\.(?:ssh|aws|config/gcloud)(?=[/\\s\"\\x27;|]|$)|\\.netrc\\b|(?<![\\w.])\\.env(?!\\.example\\b)(?=[.\\s\"\\x27;|]|$)|\\.pem\\b|\\bkeychain\\b|\\bid_(?:rsa|ed25519)(?!\\.pub)\\b|\\b(?:AWS_SECRET_ACCESS_KEY|AWS_ACCESS_KEY_ID|PRIVATE_KEY)\\b)|\\benv\\s*(?=\\|)|\\bprintenv\\s*(?=\\|)))(?=.*(?:\\bcurl(?=\\s)[^\\n;&|]*?(?:\\s(?:-d|-F|-T|--data(?:-binary|-raw|-urlencode)?|--form|--upload-file)(?=[\\s=]|$))|\\bwget(?=\\s)[^\\n;&|]*?\\s--(?:post|body)-(?:data|file)(?=[\\s=]|$)|\\b(?:nc|ncat|netcat)\\b(?![^\\n;&|]*\\s-z\\b)\\s+|\\b(?:scp|rsync)\\s+[^\\n]*?(?:[\\w.-]+@)?[\\w.-]+:|\\brequests\\s*\\.\\s*(?:post|put|patch)\\s*\\())",
      "scope": "shell_command"
    },
    {
      "id": "POL-02:DESTRUCTIVE_DDL_OR_FS",
      "weight": 90,
      "ignore_case": true,
      "pattern": "(\\bDROP\\s+TABLE\\b|\\bDROP\\s+DATABASE\\b|\\bTRUNCATE\\b|\\bDELETE\\s+FROM\\b(?![^;]*\\bWHERE\\b)|rm\\s+(-[a-zA-Z]*r[a-zA-Z]*\\s+-[a-zA-Z]*f[a-zA-Z]*|-[a-zA-Z]*f[a-zA-Z]*\\s+-[a-zA-Z]*r[a-zA-Z]*|-[a-zA-Z]*[rf]{2}[a-zA-Z]*|--recursive\\s+--force|--force\\s+--recursive)\\s+[/~*]|\\bfind\\s+.*\\s+-delete\\b|\\bgit\\s+push\\s+.*(--force|-f\\b|\\+)|mkfs|/etc/passwd)"
    },
    {
      "id": "POL-03:PRIVILEGE_ESCALATION",
      "weight": 85,
      "ignore_case": true,
      "pattern": "(\\bsudo\\b|chmod\\s+777|chown\\s+root|\\.claude/settings(\\.local)?\\.json)"
    },
    {
      "id": "POL-04:WORKFLOW_PROTECTED_KEYS",
      "weight": 85,
      "ignore_case": false,
      "pattern": "^(?:-\\s+)?(?:run|uses|permissions|'run'|'uses'|'permissions'|\\\"run\\\"|\\\"uses\\\"|\\\"permissions\\\")\\s*:",
      "scope": "workflow_edit"
    },
    {
      "id": "POL-05:PERSISTENCE_PATH",
      "weight": 85,
      "ignore_case": false,
      "scope": "write_path",
      "pattern": "(?:^|/)(?:\\.bashrc|\\.zshrc|\\.profile)$|(?:^|/)\\.git/hooks/[^/]+$|(?:^|/)(?:Library/Launch(?:Agents|Daemons)|etc/(?:systemd/system|cron\\.d)|\\.config/systemd/user)/[^/]+$|^/etc/crontab$"
    },
    {
      "id": "POL-06:DOWNLOAD_EXECUTION",
      "weight": 90,
      "ignore_case": false,
      "scope": "shell_command",
      "pattern": "(?:\\b(?:curl|wget|fetch)(?=\\s)|\\bbase64\\s+(?:-d\\b|--decode\\b))[^\\n;]*?\\|(?!\\|)\\s*(?:[^\\s|;&]+/)?(?:sh|bash|zsh|dash|python(?:[23](?:\\.\\d+)?)?|node)\\b|(?:[^\\s|;&]+/)?(?:sh|bash|zsh|dash|python(?:[23](?:\\.\\d+)?)?|node)\\b\\s+(?:-[\\w-]+\\s+)*(?:[\"\\x27])?(?:<\\(|\\$\\()\\s*(?:[^\\s]+/)?\\b(?:curl|wget|fetch)(?=\\s)|\\b(?:curl|wget|fetch)(?=\\s)[^\\n;&|]*?(?:&&|;)\\s*(?:(?:[^\\s]+/)?chmod\\s+(?:[augo]*\\+x|[0-7]{3,4})\\s+[^\\n;&|]+|(?:[^\\s|;&]+/)?(?:sh|bash|zsh|dash|python(?:[23](?:\\.\\d+)?)?|node)\\b\\s+(?:\\./|/tmp/|/var/tmp/)|(?:\\./|/tmp/|/var/tmp/)\\S+)"
    },
    {
      "id": "POL-07:REMOTE_SHELL",
      "weight": 90,
      "ignore_case": false,
      "scope": "shell_command",
      "pattern": "\\b(?:bash|sh)\\s+[^\\n;|]*?-i\\b[^\\n;|]*?/dev/tcp/|\\b(?:nc|ncat|netcat)\\s+[^\\n;|]*?\\s?-(?:e|c)(?:\\s|=)|\\bsocat\\s+[^\\n;|]*?\\bexec:|(?=[^\\n]*\\bmkfifo\\b)(?=[^\\n]*\\b(?:nc|ncat|netcat)\\b)[^\\n]*\\||\\b(?:python(?:[23](?:\\.\\d+)?)?|perl|ruby)\\s+[^\\n;]*?\\s?-c\\b(?=[^\\n]*\\bsocket\\b)(?=[^\\n]*\\b(?:pty|dup2)\\b)"
    },
    {
      "id": "POL-08:SHELL_PERSISTENCE",
      "weight": 90,
      "ignore_case": false,
      "scope": "shell_command",
      "pattern": "(?:>{1,2}\\s*[\"\\x27]?(?:[^\\s\"\\x27;&|]*/)?(?:\\.bashrc|\\.zshrc|\\.profile|\\.git/hooks/[^\\s\"\\x27;&|]+)(?=[\\s\"\\x27;&|]|$)|\\b(?:cp|mv|install)\\s+[^\\n;&|]*?\\s*[\"\\x27]?(?:[^\\s\"\\x27;&|]*/)?(?:\\.bashrc|\\.zshrc|\\.profile|\\.git/hooks/[^\\s\"\\x27;&|]+)(?=[\\s\"\\x27;&|]|$)[\"\\x27]?\\s*(?=[;&|\\n]|$)|\\bcrontab\\s+-(?=\\s*(?:[<;&|]|$))|\\bsystemctl\\s+--user\\s+enable\\b)"
    }
  ],
  "fast_chain": {
    "recon_count": 5,
    "recon_window_seconds": 30,
    "exploit_window_seconds": 60,
    "deny_session": false,
    "thresholds_note": "recon_count (5), recon_window_seconds (30), and exploit_window_seconds (60) are defaults, not tuned values. deny_session is false (receipt-only) by default.",
    "webfetch_allowlisted_domains": [
      "localhost",
      "127.0.0.1"
    ],
    "host_hook_coverage": {
      "dcode": "Hooks Bash, Write, Edit, MultiEdit, and mcp__*; dcode does not hook Read, Glob, or Grep.",
      "claude_code": "Default PreToolUse matcher is Bash|Write|Edit|MultiEdit|mcp__.*; Claude Code sends Read, Glob, Grep, or WebFetch only if the matcher includes them."
    }
  },
  "recon_classes": [
    {
      "id": "RECON-01:PROTECTED_READ_SEARCH",
      "tools": ["Read", "Grep", "Glob"],
      "requires_protected_path": true,
      "pattern": "(?i)(?:^|[/'\"\\s*])(?:\\.env(?:\\.[^/\\s'\"*]*|\\*)?|\\.aws(?:/|$|\\*)|\\.ssh(?:/|$|\\*)|\\.(?:netrc|npmrc|pypirc|bashrc|zshrc|profile|bash_profile)|\\.kube(?:/|$)|\\.claude/settings(?:\\.local)?\\.json|\\.github/workflows/|\\.git/hooks/|library/launchagents/|launchdaemons/|\\.config/systemd/user/|/etc/(?:passwd|shadow|sudoers)|credentials(?:\\.[^/\\s'\"]+)?)(?:$|[/'\"\\s*])"
    },
    {
      "id": "RECON-02:WEBFETCH_NON_ALLOWLISTED",
      "tools": ["WebFetch"],
      "requires_non_allowlisted_domain": true
    },
    {
      "id": "RECON-03:MCP_ENV_ENUMERATION",
      "tool_prefix": "mcp__",
      "pattern": "(?i)(?:(?:^|[^a-z0-9])(?:env|environ|getenv|printenv|secret|secrets|credential|credentials|token|tokens|config|settings|inventory|whoami|list_resources|list_files|list_secrets|read_resource|describe_[a-z0-9_]+|get_env)(?:$|[^a-z0-9])|\\.env\\b|\\.ssh\\b|\\.aws\\b|/etc/passwd)"
    }
  ],
  "exploit_classes": [
    {
      "id": "EXPLOIT-01:BASH_DENY_OR_PROTECTED_WRITE",
      "tools": ["Bash"],
      "matches_policy_deny": true,
      "protected_write_pattern": "(?i)(?:>{1,2}|\\b(?:tee|cp|mv|install|chmod|chown|rm|ln)\\b)[^\\n;&|]*(?:\\.env(?:\\.[^/\\s'\"]*)?|\\.aws/(?:credentials|config)|\\.ssh/|\\.(?:netrc|npmrc|pypirc|bashrc|zshrc|profile|bash_profile)|\\.kube/config|\\.claude/settings(?:\\.local)?\\.json|\\.github/workflows/|\\.git/hooks/|library/launchagents/|launchdaemons/|\\.config/systemd/user/|/etc/(?:passwd|shadow|sudoers))"
    },
    {
      "id": "EXPLOIT-02:PROTECTED_FILE_WRITE",
      "tools": ["Write", "Edit", "MultiEdit"],
      "requires_protected_path": true
    }
  ]
}
